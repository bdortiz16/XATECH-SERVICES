# XATECH P2P — configuración por variables de entorno.
# Copia este archivo a .env y cárgalo (por ejemplo: export $(grep -v '^#' .env | xargs))
# o define las variables en tu servidor. SIN credenciales la app corre en MODO DEMO.

# --- Servidor y acceso (solo login, sin registro) ---
PORT=3000
ADMIN_EMAIL=admin@xatech.services
# Opción simple (desarrollo):
ADMIN_PASSWORD=cambia-esta-clave
# Opción producción (sha256 de la clave; genera con: echo -n "tuclave" | sha256sum):
# ADMIN_PASSWORD_SHA256=
SESSION_SECRET=pon-aqui-una-cadena-larga-y-aleatoria
SESSION_HOURS=12

# --- Binance (crear API key SOLO con permisos de lectura + los del programa
#     de comerciante P2P; restringir por IP; JAMÁS habilitar retiros) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Recaudo: la llave (Bre-B) que se envía al comprador ---
BREB_KEY=@tu-llave
BREB_BANK=Tu banco
ACCOUNT_HOLDER=XATECH SERVICES S.A.S.

# --- Siigo (facturación electrónica) ---
SIIGO_USERNAME=
SIIGO_ACCESS_KEY=
SIIGO_PARTNER_ID=XatechP2P
SIIGO_DOCUMENT_ID=
SIIGO_SELLER_ID=

# --- KYC con Didit ---
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
